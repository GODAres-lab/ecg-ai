# ==============================================================================
# AI ECG Analyzer — Production VPS Environment (.env.production.example)
# Copy this file to .env on your VPS and fill in real values. NEVER commit .env!
# ==============================================================================

# Node runtime environment (bind strictly to 127.0.0.1 behind Nginx reverse proxy)
NODE_ENV="production"
PORT=3000
HOST="127.0.0.1"

# GEMINI_API_KEY: Required for server-side multimodal ECG vision interpretation.
# Generate from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# GEMINI_MODEL: Multimodal vision model identifier (e.g. gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Public HTTPS URL of your deployed domain (used for Midtrans redirects)
APP_URL="https://ecg.yourdomain.com"

# JWT_SECRET: Strong random secret (min 32 characters) for signing JWT tokens.
# Generate on Linux VPS via: openssl rand -base64 48
JWT_SECRET="GENERATE_A_RANDOM_32_PLUS_CHAR_SECRET_HERE"

# MIDTRANS PAYMENT GATEWAY (Production Dashboard: https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY="Mid-server-YOUR_PRODUCTION_SERVER_KEY"
MIDTRANS_CLIENT_KEY="Mid-client-YOUR_PRODUCTION_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION="true"
