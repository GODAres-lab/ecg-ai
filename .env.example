# ==============================================================================
# AI ECG Analyzer — Local Development Environment (.env.example)
# Copy to .env and fill in your credentials: cp .env.example .env
# ==============================================================================

# Server Binding
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# GEMINI_API_KEY: Required for server-side multimodal ECG vision interpretation.
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Multimodal vision model identifier (fallback: gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Public URL of the app (used for Midtrans Snap payment redirect callbacks)
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key (min 32 chars in production) for signing HS256 auth tokens
JWT_SECRET="ecg-ai-jwt-secret-replace-with-secure-random-key"

# MIDTRANS PAYMENT GATEWAY (Sandbox: https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION="false"
